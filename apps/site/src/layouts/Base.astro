---
import '../styles/site.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  /** Omit to fall back to the site card. */
  ogImage?: string;
  /** Set on pages that should not be indexed. */
  noindex?: boolean;
}
const { title, description, ogImage = '/og.png', noindex = false } = Astro.props;

const site = 'https://rigorrun.xyz';
const canonical = new URL(Astro.url.pathname, site).href.replace(/\/$/, '') || site;
const ogUrl = new URL(ogImage, site).href;
const full = title === 'RigorRun' ? title : `${title} — RigorRun`;
---

<!doctype html>
<html lang="en" data-theme="paper">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{full}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <!--
      The site is also reachable at rigorrun.pages.dev, which serves
      byte-identical content and does not redirect — both hostnames are attached
      to the same Pages project. This tag is not a hint on top of a 301; it is
      the only thing telling a crawler which of the two to keep.
    -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="RigorRun" />
    <meta property="og:title" content={full} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={full} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#F7F6F4" />

    <!--
      Two of the three faces are needed before first paint. They are preloaded
      rather than left to be discovered inside the stylesheet, and the fallback
      faces carry measured metric overrides, so the swap moves nothing.
    -->
    <link
      rel="preload"
      href="/fonts/instrument-sans-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="preload" href="/fonts/geist-mono-latin.woff2" as="font" type="font/woff2" crossorigin />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'SoftwareApplication',
        name: 'RigorRun',
        applicationCategory: 'DeveloperApplication',
        operatingSystem: 'macOS, Linux, Windows',
        description:
          'Acceptance testing for AI agents that take real actions. Show RigorRun a job once; it builds an executable acceptance suite and verifies your agent against what actually changed in your system.',
        url: site,
        license: 'https://opensource.org/licenses/MIT',
        offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
        author: { '@type': 'Person', name: 'Erbol Tahirov' },
      })}
    />
  </head>
  <body class="min-h-screen">
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav />
    <main id="main"><slot /></main>
    <Footer />

    <script>
      /*
       * Scroll reveal.
       *
       * The markup ships finished and visible. This opts elements *into*
       * animating rather than hiding them and hoping something undoes it,
       * which matters more than it sounds: the first version of this hid
       * every marked element the moment the class landed, and anything the
       * observer never got round to — a print, a fast scroll, a screenshot
       * tool that never fires an intersection — stayed invisible. Content
       * that needs JavaScript to appear is content that can disappear.
       *
       * So: nothing above the fold is ever hidden, and a timer reveals
       * everything regardless if the observer has not.
       */
      const wants = window.matchMedia('(prefers-reduced-motion: no-preference)');
      if (wants.matches && 'IntersectionObserver' in window) {
        const show = (el: HTMLElement) => {
          el.dataset['shown'] = 'true';
        };
        const pending: HTMLElement[] = [];
        for (const el of document.querySelectorAll<HTMLElement>('[data-reveal]')) {
          // Already on screen, or close enough that it will be before any
          // animation could read as intentional. Leave it alone.
          if (el.getBoundingClientRect().top < window.innerHeight * 1.1) continue;
          el.classList.add('rr-reveal');
          pending.push(el);
        }
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              show(entry.target as HTMLElement);
              io.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.02 },
        );
        for (const el of pending) io.observe(el);

        // Failsafe. Whatever happened, the page is readable after this.
        window.setTimeout(() => {
          io.disconnect();
          for (const el of pending) show(el);
        }, 2500);
      }
    </script>
  </body>
</html>
