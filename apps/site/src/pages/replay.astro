---
/**
 * The recorded run `rigorrun demo` replays, every case of it, for somebody who
 * has not installed anything.
 *
 * The page reads the same file the CLI bundles and refuses to build if the run
 * in it no longer matches the hash it was recorded with, exactly as the CLI
 * refuses to show it. Nothing here is typed by hand: the counts, the model, the
 * agent's words and the checks are all read from the recording.
 */
import { createHash } from 'node:crypto';
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Command from '../components/Command.astro';
import Button from '../components/Button.astro';
import replay from '../../../../fixtures/replays/demo-replay.json';

if (createHash('sha256').update(JSON.stringify(replay.run)).digest('hex') !== replay.resultHash) {
  throw new Error('fixtures/replays/demo-replay.json does not match its resultHash; re-record it rather than edit it.');
}

// Written by the LLM adapter, not the model, when the model uses every step.
const STEP_BUDGET_REPORT = 'The model ran out of its step budget before reporting a result.';

type Check = (typeof replay.run.caseResults)[number]['assertions'][number];
const failing = (checks: Check[]) => {
  const failed = checks.filter((check) => check.status === 'FAIL' || check.status === 'ERROR');
  return [...failed.filter((check) => check.unsafe), ...failed.filter((check) => !check.unsafe)];
};

const cases = replay.run.caseResults;
const passed = cases.filter((entry) => entry.outcome === 'PASS');
const failed = cases
  .filter((entry) => entry.outcome === 'FAIL')
  .sort((a, b) => b.unsafeActions - a.unsafeActions);
const unsafe = cases.reduce((sum, entry) => sum + entry.unsafeActions, 0);
const recorded = replay.recordedAt.slice(0, 10);
const commit = replay.commit.slice(0, 7);
const categories = new Set(cases.map((entry) => entry.category)).size;
---
<Base
  title="A recorded run"
  description={`${replay.model} worked a support job ${cases.length} times against a synthetic system. What it said, beside what the system held afterwards, for every case.`}
>
  <Section>
    <div class="max-w-3xl">
      <Eyebrow>A recorded run</Eyebrow>
      <h1 class="mt-4 text-display font-medium text-balance">
        What the model said, and what the system held afterwards.
      </h1>
      <p class="mt-6 text-lead text-secondary">
        A real model, <span class="font-mono text-support">{replay.model}</span>, worked a refund
        job in {replay.system}: the job as it was shown once, and {cases.length - 1} cases RigorRun
        generated from it across {categories} kinds — a limit boundary, a duplicate request, an
        instruction hidden in a ticket, a manager who says no. Every verdict below was read from the
        system after the model finished. What the model said is shown beside it and never scored.
      </p>
    </div>

    <dl class="mt-10 grid max-w-3xl grid-cols-2 gap-px overflow-hidden rounded-panel border border-line bg-line sm:grid-cols-4">
      <div class="bg-surface px-4 py-3">
        <dt class="text-micro uppercase text-muted">Cases</dt>
        <dd class="mt-1 text-title font-semibold">{cases.length}</dd>
      </div>
      <div class="bg-surface px-4 py-3">
        <dt class="text-micro uppercase text-muted">Passed</dt>
        <dd class="mt-1 text-title font-semibold text-pass">{passed.length}</dd>
      </div>
      <div class="bg-surface px-4 py-3">
        <dt class="text-micro uppercase text-muted">Failed</dt>
        <dd class="mt-1 text-title font-semibold text-fail">{failed.length}</dd>
      </div>
      <div class="bg-surface px-4 py-3">
        <dt class="text-micro uppercase text-muted">Unsafe actions</dt>
        <dd class="mt-1 text-title font-semibold text-fail">{unsafe}</dd>
      </div>
    </dl>

    <p class="mt-6 max-w-3xl text-support text-muted">
      {replay.model} ({replay.provider}), recorded {recorded} at commit
      <a class="font-mono underline" href={`https://github.com/Konuktor/rigorrun/commit/${replay.commit}`}>{commit}</a>.
      A small model on a laptop is a weak agent, and live results vary between runs; the point is
      the right-hand column, which does not depend on either.
    </p>

    <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
      <Command command="npx rigorrun demo" />
      <Button href="/start" variant="secondary">Try it on your agent</Button>
    </div>
  </Section>

  <Section ruled>
    <h2 class="text-title font-medium">The {failed.length} cases it failed</h2>
    <p class="mt-2 max-w-3xl text-support text-secondary">
      Worst first, by the number of unsafe actions the system recorded.
    </p>

    <ol class="mt-8 space-y-4">
      {failed.map((entry) => {
        const checks = failing(entry.assertions);
        const own = entry.agentReport.trim() !== STEP_BUDGET_REPORT;
        return (
          <li class="overflow-hidden rounded-panel border border-line bg-surface">
            <div class="flex flex-wrap items-center gap-x-3 gap-y-1 border-b border-line px-5 py-3">
              <span class="rounded-pill border border-fail-line bg-fail-bg px-2 py-0.5 text-micro font-semibold uppercase text-fail">
                Fail
              </span>
              <h3 class="text-support font-semibold text-fg">{entry.caseName}</h3>
              <span class="text-meta text-muted">
                {entry.category.replaceAll('_', ' ')}
                {entry.unsafeActions > 0 && ` · ${entry.unsafeActions} unsafe`}
              </span>
            </div>
            <div class="grid md:grid-cols-2">
              <div class="border-b border-line p-5 md:border-b-0 md:border-r">
                <h4 class="text-micro font-semibold uppercase text-muted">The model said</h4>
                {own ? (
                  <p class="mt-2 font-mono text-meta text-fg">&ldquo;{entry.agentReport.trim()}&rdquo;</p>
                ) : (
                  <p class="mt-2 text-meta text-muted">
                    Nothing: it used every step it had without reporting a result.
                  </p>
                )}
              </div>
              <div data-theme="ink" class="bg-canvas p-5">
                <h4 class="text-micro font-semibold uppercase text-muted">The system held</h4>
                <ul class="mt-2 space-y-2">
                  {checks.map((check) => (
                    <li class="text-meta text-fg">
                      {check.unsafe && <span class="font-semibold text-fail">Unsafe · </span>}
                      <span class="text-secondary">{check.description}</span>
                      <span class="block font-mono text-fg">{check.message}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </li>
        );
      })}
    </ol>
  </Section>

  <Section ruled>
    <h2 class="text-title font-medium">The {passed.length} cases it passed</h2>
    <ul class="mt-6 max-w-3xl space-y-3">
      {passed.map((entry) => (
        <li class="text-support">
          <span class="font-semibold text-pass">Pass</span>
          <span class="text-fg"> {entry.caseName}</span>
          <span class="block font-mono text-meta text-muted">&ldquo;{entry.agentReport.trim().split('\n')[0]}&rdquo;</span>
        </li>
      ))}
    </ul>
  </Section>

  <Section ruled>
    <div class="max-w-3xl">
      <h2 class="text-title font-medium">Checking this page</h2>
      <p class="mt-3 text-support text-secondary">
        The recording carries the SHA-256 of the run it holds,
        <span class="break-all font-mono text-meta">{replay.resultHash}</span>. This page is not built
        if the run does not match it, and <span class="font-mono text-meta">rigorrun demo</span> will
        not show it. <span class="font-mono text-meta">npx rigorrun demo --json</span> prints the
        whole recording, and <span class="font-mono text-meta">npx rigorrun demo --live</span> runs the
        pipeline on your machine now.
      </p>
    </div>
  </Section>
</Base>
