---
/**
 * One recorded case, told in the order it happened: the ticket, what the agent
 * said it did, what the system held when RigorRun read it afterwards, and the
 * verdict that read decided.
 *
 * The two middle halves are deliberately different materials. The agent's
 * sentence is set as speech on paper; the system's account is set as a record
 * on ink. The seam between them is where the product sits, so it is labelled.
 *
 * Every word and label inside comes from the recording through
 * `lib/replay.ts`. Nothing here is written for effect.
 */
import Verdict from './Verdict.astro';
import Strength from './Strength.astro';
import type { CaseView, SiteReplay } from '../lib/replay';

interface Props {
  replay: SiteReplay;
  entry: CaseView;
  /** Heading level for the card's own title, so it fits the page's outline. */
  level?: 'h2' | 'h3';
  /** Link to the full recording. Off on the recording's own page. */
  link?: boolean;
}
const { replay, entry, level = 'h2', link = true } = Astro.props;
const Title = level;
const Sub = level === 'h2' ? 'h3' : 'h4';

const lines =
  entry.reality.length > 0
    ? entry.reality
    : entry.findings.map((finding) => `${finding.description}: ${finding.message}`);
const shows = `${entry.realitySystem ?? 'The system'} shows`;
const temperature = replay.temperature === null ? null : `temperature ${replay.temperature}`;
---

<article
  class="overflow-hidden rounded-panel border border-line bg-surface shadow-[var(--shadow-lift)]"
  data-testid="claim-reality"
>
  <header class="border-b border-line px-5 pb-4 pt-4 sm:px-6">
    <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
      <p class="text-micro font-semibold uppercase text-muted">
        Support ticket <span class="font-mono normal-case tracking-normal">· {entry.caseId}</span>
      </p>
      <p class="text-meta text-muted">
        Agent&nbsp;<span class="font-mono text-secondary">{entry.agentName}</span>
      </p>
    </div>
    <Title class="mt-2 text-title font-medium text-balance">{entry.caseName}</Title>
  </header>

  <div class="px-5 pb-5 pt-5 sm:px-6 sm:pb-8">
    <Sub class="text-micro font-semibold uppercase text-muted">The agent said</Sub>
    {
      entry.said ? (
        <blockquote class="mt-2.5 text-lead text-fg">
          <p>&ldquo;{entry.said}&rdquo;</p>
        </blockquote>
      ) : (
        <p class="mt-2.5 text-support text-muted">
          {entry.outOfSteps
            ? 'Nothing: it used every step it had without reporting a result.'
            : 'Nothing: it gave no account of what it did.'}
        </p>
      )
    }
  </div>

  <!--
    `data-theme="ink"` on the element, so every token inside resolves as it
    would on a dark surface — `text-fail` included, which as a paper value all
    but disappears on ink.
  -->
  <div data-theme="ink" class="relative bg-canvas px-5 pb-5 pt-4 sm:px-6 sm:pt-8">
    <p
      class="mb-4 inline-block rounded-pill border border-line-strong bg-canvas px-3 py-1 font-mono text-micro text-secondary sm:absolute sm:left-6 sm:top-0 sm:mb-0 sm:-translate-y-1/2 sm:whitespace-nowrap"
    >
      {replay.source === 'helpdesk' ? 'then read by RigorRun, from the twin itself' : 'then read by RigorRun, with its own key'}
    </p>
    <Sub class="text-micro font-semibold uppercase text-muted">{shows}</Sub>
    <ul class="mt-2.5 space-y-1.5 font-mono text-support leading-relaxed text-fg">
      {lines.map((text) => <li class="break-words">{text}</li>)}
    </ul>
    {
      entry.readScope && (
        <p class="mt-4 border-t border-line pt-3 text-meta text-muted">
          <span class="text-secondary">Read scope.</span> {entry.readScope}
        </p>
      )
    }
  </div>

  <footer class="border-t border-line px-5 py-4 sm:px-6">
    <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
      <Verdict outcome={entry.outcome} size="lg" />
      <Strength verification={entry.verification} independence={entry.independence} />
      {
        link && (
          <a class="rr-link ml-auto text-support" href="/replay">
            Every case of this run
          </a>
        )
      }
    </div>
    <p class="mt-3 text-meta text-muted">
      <span class="font-mono text-secondary">{replay.model}</span> ({replay.provider}){
        temperature && <> · {temperature}</>
      } · recorded {replay.date} · on {replay.system}
    </p>
    {
      entry.variant && (
        <p class="mt-1 text-meta text-muted">
          <span class="font-mono text-secondary">{entry.agentName}</span> —{' '}
          {replay.variantDescriptions[entry.variant]}
        </p>
      )
    }
  </footer>
</article>
