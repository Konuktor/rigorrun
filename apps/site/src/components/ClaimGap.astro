---
/**
 * The strongest thing this product has to say, so it is said in the shape of
 * the product: what was claimed on the left, what the system holds on the
 * right, and a note that the left is not what decided the verdict.
 */
import proof from '../data/proof.json';
const demo = proof.workflows.find((workflow) => workflow.key === 'refund');
if (!demo?.failure) throw new Error('proof.json has no refund workflow with a failure to show.');
const { failure } = demo;
---

<div class="overflow-hidden rounded-panel border border-line bg-surface shadow-[var(--shadow-lift)]">
  <div class="flex flex-wrap items-center gap-x-3 gap-y-2 border-b border-line px-5 py-3.5">
    <span
      class="inline-flex items-center gap-2 rounded-pill border border-fail-line bg-fail-bg px-2.5 py-1 text-micro font-semibold uppercase text-fail"
    >
      Policy failure
    </span>
    <p class="text-support text-secondary">{failure.check}</p>
  </div>

  <div class="grid sm:grid-cols-2">
    <div class="border-b border-line p-5 sm:border-b-0 sm:border-r">
      <h3 class="text-micro font-semibold uppercase text-muted">The agent said</h3>
      <p class="mt-3 font-mono text-support text-fg">&ldquo;{failure.agentClaimed}&rdquo;</p>
      <p class="mt-4 flex items-start gap-2 text-meta text-warn">
        <svg viewBox="0 0 16 16" class="mt-0.5 h-3.5 w-3.5 shrink-0" fill="none" aria-hidden="true">
          <circle cx="8" cy="8" r="6.4" stroke="currentColor" stroke-width="1.5"></circle>
          <path d="M8 5v3.6M8 11h.01" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
        </svg>
        Not used to decide the verdict.
      </p>
    </div>

    <!--
      `data-theme="ink"` rather than a handful of `-inset` colour tokens. This
      half is a dark surface inside a light page, which is exactly what the ink
      theme is, so switching the theme on the element makes every token inside
      resolve correctly — including `text-fail`, which as a paper value is a
      dark red that all but disappears on ink.
    -->
    <div data-theme="ink" class="bg-canvas p-5">
      <h3 class="text-micro font-semibold uppercase text-muted">The system holds</h3>
      <pre
        class="mt-3 font-mono text-meta leading-relaxed text-fg"
        tabindex="0"
        role="region"
        aria-label="System state read back after the run"><code>{`{
  "Refund": {
    "count": 2,
    "customerId": "CUST-2001"
  }
}`}</code></pre>
      <p class="mt-4 text-meta text-fail">
        Expected <span class="font-mono">{failure.expected}</span>
      </p>
    </div>
  </div>
</div>
