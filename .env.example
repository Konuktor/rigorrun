# RigorRun runs completely without any of these.
# Offline deterministic mode is the default. Every variable below is OPTIONAL.

# --- Groq (free tier available) ---
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# --- Google Gemini (free tier available) ---
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# --- Any OpenAI-compatible endpoint (Ollama, LM Studio, vLLM, OpenRouter, ...) ---
# OPENAI_COMPATIBLE_BASE_URL=http://127.0.0.1:11434/v1
# OPENAI_COMPATIBLE_API_KEY=
# OPENAI_COMPATIBLE_MODEL=

# --- Optional control plane (Cloudflare Worker). Leave unset to stay fully local. ---
# RIGORRUN_API_URL=

# --- Local runner ingest port used by the recorder extension ---
# RIGORRUN_INGEST_PORT=8787
