{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": [
      "node"
    ]
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.tsx",
    "packages/*/test/**/*.ts",
    "apps/*/src/**/*.ts",
    "apps/*/src/**/*.tsx",
    "apps/vite-env.d.ts",
    "apps/extension/chrome.d.ts",
    "apps/*/test/**/*.ts",
    "e2e/**/*.ts",
    "scripts/**/*.ts",
    "*.config.ts"
  ],
  "exclude": [
    "**/node_modules",
    "**/dist",
    "apps/docs/src/content.config.ts"
  ]
}
