{
  "name": "taskdesk2: replace one task, verified independently over tasks and notes",
  "goal": "Replace task 3, Send invoices, with one task titled Quarterly report; change nothing else.",
  "connector": {
    "kind": "mcp",
    "transport": "stdio",
    "command": "{PYTHON}",
    "args": [
      "{IO}/taskdesk2_server.py",
      "--db",
      "{STATE}/desk.db",
      "--faults",
      "{STATE}/faults.json",
      "--shadow",
      "{STATE}/shadow.json",
      "--calls-log",
      "{STATE}/calls.log"
    ],
    "url": "",
    "secretNames": [],
    "verifier": {
      "kind": "mcp",
      "transport": "stdio",
      "command": "{PYTHON}",
      "args": [
        "{IO}/taskdesk2_oracle_server.py",
        "--db",
        "{STATE}/desk.db",
        "--down-flag",
        "{STATE}/oracle-down.flag",
        "--empty-flag",
        "{STATE}/oracle-empty.flag",
        "--calls-log",
        "{STATE}/calls.log"
      ],
      "url": "",
      "secretNames": []
    }
  },
  "safety": "local",
  "readOnlyTools": [
    "list_tasks",
    "list_notes",
    "verifier:query_tasks",
    "verifier:query_notes"
  ],
  "verifierReads": [
    {
      "tool": "verifier:query_tasks",
      "args": {}
    },
    {
      "tool": "verifier:query_notes",
      "args": {}
    }
  ],
  "reset": {
    "kind": "tool",
    "tool": "reset_desk"
  },
  "teach": [
    {
      "tool": "list_tasks",
      "args": {}
    },
    {
      "tool": "delete_task",
      "args": {
        "id": 3
      }
    },
    {
      "tool": "create_task",
      "args": {
        "title": "Quarterly report"
      }
    }
  ],
  "answers": {},
  "review": {
    "confirm": [],
    "reject": []
  },
  "quality": false,
  "agents": [
    {
      "name": "io2-replace-correct",
      "command": "{PYTHON}",
      "args": [
        "{AGENTS}/scripted-agent.py",
        "{PLAYBOOKS}/io2-replace-correct.json",
        "{TRACES}"
      ],
      "cwd": "{STATE}"
    },
    {
      "name": "io2-replace-extra-note-edit",
      "command": "{PYTHON}",
      "args": [
        "{AGENTS}/scripted-agent.py",
        "{PLAYBOOKS}/io2-replace-extra-note-edit.json",
        "{TRACES}"
      ],
      "cwd": "{STATE}"
    }
  ]
}
