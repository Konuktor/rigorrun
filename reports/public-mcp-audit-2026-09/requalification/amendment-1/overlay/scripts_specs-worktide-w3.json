{
  "secrets": {
    "WORKTIDE_API_TOKEN": "AUDIT_WORKTIDE_API_TOKEN",
    "WORKTIDE_API_URL": "AUDIT_WORKTIDE_API_URL",
    "WORKTIDE_WORKSPACE_ID": "AUDIT_WORKTIDE_WORKSPACE_ID"
  },
  "connector": {
    "kind": "mcp",
    "transport": "stdio",
    "command": "node",
    "args": [
      "{REPO}/tmp/rigorrun-audit/worktide-mcp/dist/index.js"
    ],
    "secretNames": [
      "WORKTIDE_API_TOKEN",
      "WORKTIDE_API_URL",
      "WORKTIDE_WORKSPACE_ID"
    ]
  },
  "safety": "local",
  "readOnlyTools": [
    "tasks.search",
    "tasks.get",
    "projects.list",
    "projects.get",
    "projects.board",
    "time.runningTimer",
    "time.report",
    "me.whoami",
    "me.myAssignedTasks"
  ],
  "verifierReads": [
    {
      "tool": "time.runningTimer",
      "args": {}
    },
    {
      "tool": "time.report",
      "args": {
        "from": "2026-09-01",
        "to": "2026-12-31",
        "groupBy": "task"
      }
    },
    {
      "tool": "tasks.search",
      "args": {
        "projectKey": "AUD",
        "limit": 50
      }
    }
  ],
  "reset": {
    "kind": "none"
  },
  "answers": {},
  "review": {
    "confirm": [],
    "reject": []
  },
  "quality": true,
  "agents": [],
  "name": "worktide W3 track one minute against task AUD-2",
  "goal": "Start a timer on task AUD-2 described 'Evidence work', let it run for one minute, then stop it, so that AUD-2 gains exactly one time entry and no timer is left running.",
  "teach": [
    {
      "tool": "tasks.search",
      "args": {
        "projectKey": "AUD",
        "limit": 50
      }
    },
    {
      "tool": "time.start",
      "args": {
        "taskIri": "/v1/tasks/01a09c48-96db-7179-93b5-9de4616ac34e",
        "description": "Evidence work"
      }
    },
    {
      "sleepSeconds": 61
    },
    {
      "tool": "time.stop",
      "args": {}
    }
  ]
}