    {
      "id": "E-2",
      "target": "email-mcp",
      "category": "TARGET_MCP_BUG",
      "severity": "MEDIUM",
      "status": "CONFIRMED",
      "title": "13 advertised tools fail with ModuleNotFoundError: the autorespond and watcher modules are not in the repository",
      "reproduction": "3/3"
    },
    {
      "id": "E-3",
      "target": "email-mcp",
      "category": "TARGET_MCP_RELIABILITY_RISK",
      "severity": "LOW",
      "status": "CONFIRMED",
      "title": "send_email is at-least-once with no idempotency key: a lost response plus one client retry delivers two messages",
      "reproduction": "3/3"
    },
    {
      "id": "E-4",
      "target": "email-mcp",
      "category": "NO_ISSUE_FOUND",
      "severity": "INFO",
      "status": "CONFIRMED",
      "title": "Runtime service configuration is lost on restart, exactly as documented",
      "reproduction": "3/3"
    },
    {
      "id": "W-1",
      "target": "worktide-mcp",
      "category": "TARGET_MCP_BUG",
      "severity": "HIGH",
      "status": "CONFIRMED",
      "title": "Every tool that resolves an IRI doubles the /v1 prefix and gets a 404: tasks.get, tasks.update, tasks.complete, projects.get, projects.archive",
      "reproduction": "3/3"
    },
    {
      "id": "W-2",
      "target": "worktide-mcp",
      "category": "TARGET_MCP_BUG",
      "severity": "HIGH",
      "status": "CONFIRMED",
      "title": "tasks.create, tasks.addDependency, time.log and projects.create answer 500 against the pinned backend: the MCP omits the workspace/user the API requires",
      "reproduction": "3/3"
    },
    {
      "id": "W-3",
      "target": "worktide-mcp",
      "category": "TARGET_MCP_RELIABILITY_RISK",
      "severity": "LOW",
      "status": "CONFIRMED",
      "title": "The backend answers a missing required relation with HTTP 500 instead of a validation error",
      "reproduction": "3/3"
    },
    {
      "id": "S-1",
      "target": "sqlite-mcp",
      "category": "TARGET_MCP_BUG",
      "severity": "MEDIUM",
      "status": "CONFIRMED",
      "title": "backup copies the whole database to any path under deny-everything (and read-only); vacuum is correctly denied",
      "reproduction": "3/3"
    },
    {
      "id": "S-2",
      "target": "sqlite-mcp",
      "category": "TARGET_MCP_BUG",
      "severity": "LOW",
      "status": "CONFIRMED",
      "title": "rows_changed reports the previous statement's count for a read-only statement",
      "reproduction": "3/3"
    },
    {
      "id": "S-3",
      "target": "sqlite-mcp",
      "category": "TARGET_MCP_RELIABILITY_RISK",
      "severity": "LOW",
      "status": "CONFIRMED",
      "title": "A read-only server pointed at a missing path silently creates an empty database file",
      "reproduction": "3/3"
    },
    {
      "id": "S-4",
      "target": "sqlite-mcp",
      "category": "TARGET_MCP_RELIABILITY_RISK",
      "severity": "LOW",
      "status": "CONFIRMED",
      "title": "execute is at-least-once: a lost response plus one client retry inserts two rows",
      "reproduction": "3/3"
    },
    {
      "id": "S-5",
      "target": "sqlite-mcp",
      "category": "NO_ISSUE_FOUND",
      "severity": "INFO",
      "status": "CONFIRMED",
      "title": "Presets, column-level deny, timeout interruption, single-statement enforcement and sequential BEGIN/INSERT/ROLLBACK all behave as documented",
      "reproduction": "3/3"
    },
    {
      "id": "R-1",
      "target": "all",
      "category": "RIGORRUN_BUG",
      "severity": "HIGH",
      "status": "CONFIRMED",
      "title": "For a system that cannot be seeded, the verdict's baseline is the demonstration-time snapshot, not a fresh read at case start: a correct agent fails and a drifted world passes",
      "reproduction": "3/3 on sqlite (W1 and W1b), 3/3 on email (reset and accumulate modes), 3/3 with a real LLM agent"
    },
    {
      "id": "R-2",
      "target": "all",
      "category": "RIGORRUN_PRODUCT_GAP",
      "severity": "HIGH",
      "status": "CONFIRMED",
      "title": "No independent oracle: the verdict can only read the target server's own nominated tools, and a project takes one connector",
      "reproduction": "structural (packages/daemon/src/project.ts, packages/connector/src/environment.ts)"
    },
    {
      "id": "R-3",
      "target": "sqlite-mcp",
      "category": "RIGORRUN_PRODUCT_GAP",
      "severity": "MEDIUM",
      "status": "CONFIRMED",
      "title": "Column-cell result shapes are induced as a value-keyed 'Id' entity, not as table rows; RigorRun's own quality gate flags the resulting suite",
      "reproduction": "2/2 journeys (W1, W1b)"
    },
    {
      "id": "R-4",
      "target": "all",
      "category": "RIGORRUN_PRODUCT_GAP",
      "severity": "MEDIUM",
      "status": "CONFIRMED",
      "title": "Generated cases carry a fixed 15 s budget, shorter than the 20 s MCP call timeout, so a case cannot survive one lost response, and slow local models cannot finish",
      "reproduction": "3/3 (EM-GM-06), 3/3 (SQ-LLM-01), 3/3 (EM-LLM-01)"
    },
    {
      "id": "R-5",
      "target": "sqlite-mcp",
      "category": "RIGORRUN_BUG",
      "severity": "LOW",
      "status": "CONFIRMED",
      "title": "The task instruction is built from the primary tool's description rather than the project goal, and a dual-purpose tool's last call becomes the primary action",
      "reproduction": "2/2 journeys"
    },
    {
      "id": "R-6",
      "target": "all",
      "category": "RIGORRUN_PRODUCT_GAP",
      "severity": "LOW",
      "status": "CONFIRMED",
      "title": "No headless project setup; connecting and teaching are interface-only, so the audit drove the runner's HTTP API directly",
      "reproduction": "documented (docs/V1_GAP_AUDIT.md)"
    },
    {
      "id": "R-8",
      "target": "worktide-mcp",
      "category": "RIGORRUN_BUG",
      "severity": "HIGH",
      "status": "CONFIRMED",
      "title": "A server that returns JSON only as text content passes the read-nomination probe but yields no records at demonstration time, so compile refuses after the job has been demonstrated",
      "reproduction": "2/2 journeys (W2, W3)"
    },
    {
      "id": "R-7",
      "target": "all",
      "category": "RIGORRUN_PRODUCT_GAP",
      "severity": "INFO",
      "status": "CONFIRMED",
      "title": "`rigorrun verify --needs-credential` is documented but not wired into the CLI; verify accepts only Node servers from npm: or dir:",
      "reproduction": "1/1"
    },
