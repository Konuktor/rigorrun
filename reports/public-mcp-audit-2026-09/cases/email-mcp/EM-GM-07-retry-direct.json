        "to": "qa@example.test",
        "subject": "Audit 17",
        "body": "Audit message 17 (retry probe)",
        "service": "default"
      }
    },
    {
      "tool": "send_email",
      "args": {
        "to": "qa@example.test",
        "subject": "Audit 17",
        "body": "Audit message 17 (retry probe)",
        "service": "default"
      }
    }
  ],
  "expect": "after['total']==before['total']+1",
  "notes": "mode=direct because RigorRun's fixed 15 s case budget is shorter than its 20 s MCP call timeout, so a case cannot survive one lost response (see RigorRun findings). mcp-call.py uses a 5 s per-call timeout here."
