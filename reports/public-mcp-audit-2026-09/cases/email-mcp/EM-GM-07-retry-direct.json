    "IMAP_SERVER": "127.0.0.1",
    "IMAP_PORT": "3993",
    "IMAP_USER": "qa",
    "IMAP_PASSWORD": "secret",
    "FAULT_DROP_TOOL": "send_email",
    "FAULT_DROP_NTH": "1",
    "FAULT_LOG": "{REPO}/reports/public-mcp-audit-2026-09/traces/email-mcp/fault-proxy-direct.jsonl"
  },
  "server": [
    "node",
    "{REPO}/reports/public-mcp-audit-2026-09/scripts/fault-proxy.mjs",
    "--",
