{
  "id": "SQ-D-06-timeout-interrupts",
  "target": "sqlite-mcp",
  "mode": "direct",
  "oracle": "oracle-sqlite.py",
  "initialState": "seed: tasks 1-3, audit_log 1",
  "class": "TIMEOUT",
  "truth": "EXPECTED_PASS",
  "intent": "--timeout-ms 200 must interrupt a long query and the server must keep serving",
  "server": [
    "{REPO}/tmp/rigorrun-audit/toolchain/bin/mcp-server-sqlite",
    "--database",
    "{REPO}/tmp/rigorrun-audit/sqlite-mcp/audit.db",
    "--preset",
    "read-only",
    "--timeout-ms",
    "200"
  ],
  "calls": [
    {
      "tool": "execute",
      "args": {
        "query": "WITH RECURSIVE c(x) AS (SELECT 1 UNION ALL SELECT x+1 FROM c WHERE x<30000000) SELECT count(*) FROM c"
      }
    },
    {
      "tool": "execute",
      "args": {
        "query": "SELECT 1"
      }
    }
  ],
  "expect": "calls[0]['result']['isError']==True and calls[1]['result']['isError']==False"
}