{
  "id": "WT-D-10-double-start-closes-first",
  "target": "worktide-mcp",
  "mode": "direct",
  "oracle": "oracle-worktide.py (REST with the audit token + direct MySQL)",
  "initialState": "snapshot: project AUD with AUD-1..3 in Backlog, no running timer, 10 fixture time entries",
  "env": {
    "WORKTIDE_API_URL": "http://127.0.0.1:18081/v1",
    "WORKTIDE_API_TOKEN": "{WORKTIDE_PAT}",
    "WORKTIDE_WORKSPACE_ID": "{WORKTIDE_WORKSPACE}"
  },
  "server": [
    "node",
    "{REPO}/tmp/rigorrun-audit/worktide-mcp/dist/index.js"
  ],
  "class": "DUPLICATE_SIDE_EFFECT / boundary",
  "truth": "EXPECTED_PASS",
  "intent": "a second time.start while one runs: documented as closing the first (closedTimeEntryId); two entries result, none running",
  "calls": [
    {
      "tool": "time.start",
      "args": {
        "description": "first"
      }
    },
    {
      "tool": "time.start",
      "args": {
        "description": "second"
      }
    },
    {
      "tool": "time.stop",
      "args": {}
    }
  ],
  "expect": "after['db_active_timer_count']==0 and after['db_time_entry_count']==before['db_time_entry_count']+2 and 'closedTimeEntryId' in calls[1]['result']['content'][0]['text']"
}