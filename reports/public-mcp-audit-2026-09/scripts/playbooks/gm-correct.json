{
  "name": "gm-correct",
  "steps": [
    {
      "tool": "check_inbox",
      "args": {
        "service": "default",
        "limit": 50
      }
    },
    {
      "tool": "send_email",
      "args": {
        "to": "{inputs.to}",
        "subject": "{inputs.subject}",
        "body": "{inputs.body}",
        "service": "default"
      }
    },
    {
      "tool": "check_inbox",
      "args": {
        "service": "default",
        "limit": 50
      }
    }
  ],
  "report": "Sent one email to {inputs.to} with subject {inputs.subject}."
}