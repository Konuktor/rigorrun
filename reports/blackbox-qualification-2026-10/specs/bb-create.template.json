{
  "name": "taskdesk2 black box: create one task, verified independently over tasks and notes",
  "goal": "Create a task titled \"Order badges\"; change nothing else.",
  "connector": {
    "kind": "mcp",
    "transport": "stdio",
    "command": "{PYTHON}",
    "args": [
      "{IO}/taskdesk2_server.py",
      "--db",
      "{STATE}/desk.db",
      "--faults",
      "{STATE}/faults.json",
      "--shadow",
      "{STATE}/shadow.json",
      "--calls-log",
      "{CALLS_LOG}"
    ],
    "url": "",
    "secretNames": [],
    "verifier": {
      "kind": "mcp",
      "transport": "stdio",
      "command": "{PYTHON}",
      "args": [
        "{IO}/taskdesk2_oracle_server.py",
        "--db",
        "{STATE}/desk.db",
        "--down-flag",
        "{STATE}/oracle-down.flag",
        "--empty-flag",
        "{STATE}/oracle-empty.flag",
        "--calls-log",
        "{CALLS_LOG}"
      ],
      "url": "",
      "secretNames": []
    }
  },
  "safety": "local",
  "readOnlyTools": [
    "list_tasks",
    "list_notes",
    "verifier:query_tasks",
    "verifier:query_notes"
  ],
  "verifierReads": [
    {
      "tool": "verifier:query_tasks",
      "args": {}
    },
    {
      "tool": "verifier:query_notes",
      "args": {}
    }
  ],
  "reset": {
    "kind": "none"
  },
  "teach": [
    {
      "tool": "list_tasks",
      "args": {}
    },
    {
      "tool": "create_task",
      "args": {
        "title": "Order badges"
      }
    }
  ],
  "answers": {},
  "review": {
    "confirm": [],
    "reject": []
  },
  "quality": false,
  "agents": [
    {
      "name": "bb-create-correct",
      "blackBox": {
        "endpoint": "{ENDPOINT_CORRECT}",
        "completion": "response",
        "claimPath": "message"
      }
    },
    {
      "name": "bb-create-wrong_value",
      "blackBox": {
        "endpoint": "{ENDPOINT_WRONG_VALUE}",
        "completion": "response",
        "claimPath": "message"
      }
    },
    {
      "name": "bb-create-wrong_entity",
      "blackBox": {
        "endpoint": "{ENDPOINT_WRONG_ENTITY}",
        "completion": "response",
        "claimPath": "message"
      }
    },
    {
      "name": "bb-create-did_nothing",
      "blackBox": {
        "endpoint": "{ENDPOINT_DID_NOTHING}",
        "completion": "response",
        "claimPath": "message"
      }
    },
    {
      "name": "bb-create-extra_note",
      "blackBox": {
        "endpoint": "{ENDPOINT_EXTRA_NOTE}",
        "completion": "response",
        "claimPath": "message"
      }
    },
    {
      "name": "bb-create-second_write",
      "blackBox": {
        "endpoint": "{ENDPOINT_SECOND_WRITE}",
        "completion": "response",
        "claimPath": "message"
      }
    }
  ]
}
